.env
.env.*
!.env.example
.wrangler/
node_modules/

# Worker bundles are build artifacts but are committed on purpose: Terraform
# reads them with file(), so a clone can still plan without a node toolchain.
# CI rebuilds them and fails if either drifts from its source.
#
# Both lines are needed. A global gitignore here has `dist/`, and git will not
# descend into an excluded *directory* to find a re-included file -- so the
# directory has to be un-ignored before the file can be.
!infra/worker/dist/
infra/worker/dist/*
!infra/worker/dist/compact.js
