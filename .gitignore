.env
.env.*
!.env.example
.wrangler/
node_modules/

# infra/worker/dist/compact.js is a build artifact but is committed on purpose:
# Terraform reads it with file(), so a clone without a node toolchain must still
# be able to `tofu apply`. CI rebuilds it and fails if it drifts from source.
#
# Both lines are needed. A global gitignore here has `dist/`, and git will not
# descend into an excluded *directory* to find a re-included file -- so the
# directory has to be un-ignored before the file can be.
!infra/worker/dist/
!infra/worker/dist/compact.js
