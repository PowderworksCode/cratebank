{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cratebank-site-preview",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
