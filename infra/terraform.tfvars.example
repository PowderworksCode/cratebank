# Copy to prod.tfvars (gitignored) and fill in.

# API token: create at https://dash.cloudflare.com/profile/api-tokens
#   Account | Workers Scripts    | Edit    (deploying the Worker)
#   Account | Workers R2 Storage | Edit    (the bucket)
#   Zone    | Workers Routes     | Edit    (only if you set zone_id below)
#   Zone    | DNS                | Edit    (the custom domain writes a record)
#
# Adding a Zone row makes a "Zone Resources" selector appear below Account
# Resources. It defaults to All zones -- narrow it to this one zone.
cloudflare_api_token = ""

# Dashboard URL: dash.cloudflare.com/<this is your account id>
account_id = ""

# Optional. Leave empty on a first apply: the custom domain is skipped and the
# Worker is reachable at its workers.dev subdomain, so the path is testable
# before the domain exists.
zone_id   = ""
zone_name = "cratebank.io"

# Bearer token guarding the compactor's manual POST /compact trigger.
# Any random string: openssl rand -hex 24
compact_secret = ""

bucket_name     = "cratebank"
bucket_location = "ENAM" # WNAM ENAM WEUR EEUR APAC OC
